# Plantilla de variables de entorno. Copia los valores reales a:
#   - apps/web/.env.local   (web, Next.js)
#   - apps/mobile/.env      (móvil, Expo)
# Este archivo de ejemplo SÍ se sube al repositorio; los archivos con
# valores reales, NUNCA (ya están excluidos en .gitignore).

# --- Supabase (proyecto de desarrollo) ---
# Configuración → API, en el panel de Supabase de tu proyecto.
# Next.js usa el prefijo NEXT_PUBLIC_, Expo usa el prefijo EXPO_PUBLIC_ —
# mismos valores, dos nombres distintos por convención de cada framework.

# apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# La "service role key" (acceso total, salta las reglas de seguridad) NUNCA va en un
# archivo de este tipo que use el navegador o la app móvil. Solo se usa en el servidor
# (apps/web/src/lib/supabase/admin.ts) — desde el Hito 4, para las pocas escrituras que
# ninguna política de RLS puede autorizar por sí sola (grabar qué propuso de verdad la
# IA, RN-CLS-01/04/05: no puede depender de lo que el cliente afirme). Sin el prefijo
# NEXT_PUBLIC_, a propósito: nunca debe llegar al bundle del navegador.
# apps/web/.env.local
SUPABASE_SERVICE_ROLE_KEY=

# --- Clasificación de solicitudes con IA (Hito 4) ---
# Se lee solo en el servidor (apps/web/src/services/ai-classifier.ts) y
# nunca se expone al cliente (RN-CLS-01). Si se deja vacía, o si la
# llamada a Anthropic falla o tarda demasiado, el sistema cae
# automáticamente al motor de reglas por palabras clave (RN-CLS-02) — no
# es necesaria para poder crear y enviar solicitudes en desarrollo.
ANTHROPIC_API_KEY=

# --- Propietario de Cuotly (Hito 2) ---
# Documental: quién es "Bosco" para el producto. La comprobación real que
# protege el botón "Crear Restavor" vive en la base de datos
# (función is_platform_owner(), supabase/migrations/20260830000006_platform_and_audit.sql),
# no en esta variable — así hay un único sitio de verdad, no dos que puedan
# desincronizarse. Si el correo cambia alguna vez, se actualiza con una
# migración nueva que sustituya esa función.
CUOTLY_OWNER_EMAIL=info@restavor.com

# --- La cola periódica y el correo (Hito 8) ---
# El proceso de la cola vive en apps/web/src/services/queue-runner.ts y se
# dispara con POST /api/cola. No lo llama ninguna pantalla: lo llama un
# cron externo, que se autentica con este secreto compartido. Si no está
# configurado, la ruta responde 503 en vez de quedarse abierta.
# apps/web/.env.local
QUEUE_RUNNER_SECRET=

# Resend, el proveedor de correo. Si la clave falta, los avisos NO se
# pierden: se quedan en la cola con espera creciente (RN-NOT-05) y salen
# en cuanto se configure. Nunca se marcan como enviados sin haberlo sido.
# apps/web/.env.local
RESEND_API_KEY=
RESEND_FROM=Cuotly <avisos@cuotly.com>

# Dirección pública del sitio, para que los enlaces de los correos sean
# absolutos: un correo no tiene origen desde el que resolver una ruta.
# apps/web/.env.local
NEXT_PUBLIC_SITE_URL=
